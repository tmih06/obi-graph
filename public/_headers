# Cloudflare Pages headers for the demo.
#
# Asset filenames carry a content hash, so they can be cached forever. The HTML
# entry point must stay revalidated or a deploy would not reach returning
# visitors.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400
