{
  "name": "obi-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Canvas graph render engine extracted from Trendifest: d3-force layout, camera pan/zoom, node dragging and selection.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/graph/index.ts",
      "default": "./src/graph/index.ts"
    },
    "./styles.css": "./src/graph/graph.css"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "fmt": "vp fmt",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
