{
  "name": "obi-graph",
  "version": "0.1.0",
  "description": "Obsidian-style force-directed graph view for React on a single canvas: zoom-faded labels, hover focus, draggable nodes, pan and zoom.",
  "keywords": [
    "canvas",
    "d3-force",
    "force-directed",
    "graph",
    "graph-view",
    "network",
    "obsidian",
    "react",
    "visualization"
  ],
  "homepage": "https://github.com/tmih06/obi-graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmih06/obi-graph.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "bun run build:lib && bun run build:demo",
    "build:lib": "bun ./scripts/build-lib.ts",
    "build:demo": "vp build",
    "preview": "vp preview",
    "prepack": "bun run build:lib",
    "check": "vp check",
    "fmt": "vp fmt",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "ci": "bun run check:ci && bun run test && bun run build",
    "check:ci": "bun run check:fmt && bun run check:lint && bun run typecheck",
    "check:fmt": "vp fmt --check",
    "check:lint": "vp lint --deny-warnings",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "d3-force": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "agentation": "^3.1.2",
    "marked": "15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
